# Copy this file to .env only inside ~/sheperd_runtime/shepherd_backend.
# The Python 3.8 API receives frames and detections from the Python 3.6 worker.
INFERENCE_BACKEND=jetson
JETSON_WORKER_URL=http://127.0.0.1:8766
JETSON_WORKER_POLL_TIMEOUT_SECONDS=2
JETSON_WORKER_REQUEST_TIMEOUT_SECONDS=4

INFLUXDB_ENABLED=true
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=REPLACE_WITH_JETSON_INFLUXDB_TOKEN
INFLUXDB_ORG=Lambs
INFLUXDB_BUCKET=crowd_monitor
# 반드시 ext4 저장소 경로를 사용하세요. 현재 exFAT 외장 파티션에는 두지 않습니다.
INFLUXDB_OUTBOX_PATH=/mnt/shepherd-data/outbox/metrics_outbox.sqlite3
INFLUXDB_OUTBOX_MOUNT=/mnt/shepherd-data
INFLUXDB_RETRY_SECONDS=5
INFLUXDB_BATCH_SIZE=100

# 기본값은 현재 인원이 유지된다는 1분 뒤 기준선입니다.
# trend는 기존 직선 추세식으로, 검증에서 오차가 커 실험용으로만 남깁니다.
FORECAST_MODE=persistence
FORECAST_HORIZON_SECONDS=60
FORECAST_HISTORY_SECONDS=120
FORECAST_MIN_TREND_SPAN_SECONDS=30
FORECAST_BUCKET_SECONDS=5

CAMERAS_CONFIG_PATH=./jetson_worker/cameras.local.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
