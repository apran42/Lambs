# Copy this file to .env only inside ~/sheperd_runtime/shepherd_backend.
# The Python 3.8 API process intentionally starts without an AI runtime.
INFERENCE_BACKEND=unavailable
INFERENCE_UNAVAILABLE_REASON=Jetson TensorRT inference worker is not connected yet.

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=Lambs
INFLUXDB_BUCKET=crowd_monitor

CAMERAS_CONFIG_PATH=./cameras.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
