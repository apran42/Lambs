# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=Lambs
INFLUXDB_BUCKET=crowd_monitor

# Local video now; set VIDEO_PATH=0 for the first USB webcam later.
# Use unavailable on the Jetson Python 3.8 API process until its TensorRT
# inference worker is connected. The development PC keeps ultralytics.
INFERENCE_BACKEND=ultralytics
INFERENCE_UNAVAILABLE_REASON=AI inference runtime is not connected.
YOLO_MODEL_PATH=../yolov8n.pt
VIDEO_PATH=../data/sample_data (1).mp4
VIDEO_LOOP=true
FRAME_WIDTH=640
FRAME_HEIGHT=480
CAPTURE_FPS=20
INFERENCE_BATCH_SIZE=2
# Keep CPU inference from starving the independent video capture workers.
CPU_INFERENCE_THREADS=2
CPU_INTEROP_THREADS=1
OPENCV_THREADS=1
CAMERAS_CONFIG_PATH=./cameras.json

YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=
YOLO_TRACKER=bytetrack.yaml

JPEG_QUALITY=80
DB_WRITE_INTERVAL_SECONDS=1
CROWDED_COUNT_THRESHOLD=10
CALIBRATION_PATH=./calibration_data.json
CALIBRATION_IMAGES_PATH=./calib_images
ROI_CONFIG_PATH=./roi_config.json

# Default virtual model zone: 3 m x 3 m, so each 3x3 cell is 1 m2.
ZONE_WIDTH_M=3
ZONE_HEIGHT_M=3
DENSITY_RELAXED_MAX=2
DENSITY_DANGER_MIN=5
DENSITY_GRID_ROWS=3
DENSITY_GRID_COLS=3
LOCAL_WINDOW_WIDTH_M=1
LOCAL_WINDOW_HEIGHT_M=1
LOCAL_WINDOW_STEP_M=0.1
# Keep the sliding 1 m2 peak algorithm available but inactive for now.
ENABLE_LOCAL_PEAK_DENSITY=false

# Conservative five-minute online forecast. It falls back to persistence until
# at least 60 seconds of observations have accumulated.
FORECAST_HORIZON_SECONDS=300
FORECAST_HISTORY_SECONDS=600
FORECAST_MIN_TREND_SPAN_SECONDS=60
FORECAST_BUCKET_SECONDS=5

CAMERA_ID=cam-01
FACILITY_NAME=model-zone
CAMERA_LOCATION=zone-a
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
